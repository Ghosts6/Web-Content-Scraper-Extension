{
  "manifest_version": 3,
  "name": "Web Content Scraper",
  "version": "1.0",
  "description": "Extract structured content from any webpage",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrape Content"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.ts"]
    }
  ],
  "background": {
    "service_worker": "background.ts"
  },
  "web_accessible_resources": [
    {
      "resources": ["*"],
      "matches": ["<all_urls>"]
    }
  ]
}